<?xml version="1.0" encoding="utf-8"?>
<!-- Godot's C# packages ship inside the editor; build from them so no download is needed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-bundled" value="/Applications/Godot_mono.app/Contents/Resources/GodotSharp/Tools/nupkgs" />
  </packageSources>
</configuration>
